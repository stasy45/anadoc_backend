{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "rootDir": "./src",
    "outDir": "./dist",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": false
  },
  "include": ["src/**/*"]
}